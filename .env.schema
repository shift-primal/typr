# Typr env schema (spec 0001). Committed; holds no secret values.
# Secrets resolve from Bitwarden Secrets Manager by UUID. Which UUIDs load
# depends on APP_ENV: .env.development (project typr-dev) or .env.production (project typr-prod).
# The only value set by hand is BWS_ACCESS_TOKEN (plus APP_ENV), in .env.local, Coolify, or CI.
#
# @defaultSensitive=false @defaultRequired=infer
# @currentEnv=$APP_ENV
# @plugin(@varlock/bitwarden-plugin@2.0.1)
# @initBitwarden(accessToken=$BWS_ACCESS_TOKEN)
# ---

# Selects the env file (and so the Bitwarden project) secrets resolve from
# @type=enum(development, production)
APP_ENV=development

# Bitwarden machine account token. Dev token reads only typr-dev; prod token reads only typr-prod.
# @type=bitwardenAccessToken @sensitive @required
BWS_ACCESS_TOKEN=

# Neon direct (unpooled) connection string with sslmode=require. dev branch locally, main in production.
# @sensitive @required
DATABASE_URL=bitwarden("98255c6a-30d4-4a68-b2f8-b4d500bebb44")

# Better Auth session signing secret (used from feature 7)
# @sensitive @required
BETTER_AUTH_SECRET=bitwarden("f58cfc8b-d1a6-4185-a738-b4d500c1296e")

# App origin: auth base URL and the only allowed websocket Origin
# @type=url
BETTER_AUTH_URL=if(eq($APP_ENV, production), "https://typr.haugestol.com", "http://localhost:3000")

# Used by CI only, to trigger a Coolify deploy
# @sensitive @optional
COOLIFY_WEBHOOK_URL=
# @sensitive @optional
COOLIFY_API_TOKEN=

# @type=port
PORT=3000

# Commit SHA, baked into the image as a build arg; reported by /api/health
APP_VERSION=dev
